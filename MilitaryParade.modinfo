<?xml version='1.0' encoding='utf-8'?>
<Mod id="73377b9b-1e5f-448a-bbc3-6d79fc86d912" version="25">
  <Properties>
    <Name>阅兵 · Military Parade</Name>
    <Description>首发版1.0.0。完成帝国初期后，可在有本国战斗驻军的当前首都进行阅兵。获得10回合军事鼓舞、大将军点数及时代分。需要迭起兴衰或风云变幻规则集，仅支持单人。</Description>
    <Teaser>首发版 1.0.0：首都阅兵、十回合鼓舞、大将军与时代分奖励。</Teaser>
    <Authors>21587</Authors>
    <AffectsSavedGames>1</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>0</SupportsHotSeat>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <ActionCriteria>
    <Criteria id="ParadeXP2">
      <GameCoreInUse>Expansion2</GameCoreInUse>
    </Criteria>
  </ActionCriteria>
  <InGameActions>
    <UpdateDatabase id="ParadeV38_Data">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <File>Parade_Data.sql</File>
    </UpdateDatabase>
    <UpdateDatabase id="ParadeV38_XP2" criteria="ParadeXP2">
      <Properties>
        <LoadOrder>1001</LoadOrder>
      </Properties>
      <File>Parade_Data_XP2.sql</File>
    </UpdateDatabase>
    <UpdateDatabase id="ParadeV38_Quotes">
      <Properties>
        <LoadOrder>1002</LoadOrder>
      </Properties>
      <File>Parade_Quotes.sql</File>
    </UpdateDatabase>
    <UpdateText id="ParadeV38_Text">
      <File>Parade_Text.sql</File>
    </UpdateText>
